# Copy to keystore.properties and fill in. That file is never committed:
# whoever holds it can publish an update to the app.
#
# Create the key once with:
#   keytool -genkeypair -v -keystore paychat-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias paychat
#
# Losing it means the app can never be updated again under this listing, so
# keep the .jks file and this password somewhere they will outlive the laptop.
storeFile=../paychat-release.jks
storePassword=
keyAlias=paychat
keyPassword=
