rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isParticipant(threadId) {
      return isSignedIn()
        && (
          request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds
          || (
            request.auth.token.phone_number != null
            && request.auth.token.phone_number in get(/databases/$(database)/documents/threads/$(threadId)).data.participantPhones
          )
        );
    }

    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /user_directory/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /threads/{threadId} {
      allow create: if isSignedIn()
        && (
          request.auth.uid in request.resource.data.participantIds
          || (
            request.auth.token.phone_number != null
            && request.auth.token.phone_number in request.resource.data.participantPhones
          )
        );
      allow read, update: if isParticipant(threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if isParticipant(threadId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
