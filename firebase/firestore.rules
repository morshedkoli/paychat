rules_version = '2';

// PayChat security rules.
//
// These rules are the only thing standing between a user and someone else's
// money records, so every ledger invariant from docs/SPEC.md section 6 is
// enforced here rather than in the client.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // The phone number Firebase Auth itself verified by OTP. Present only on
    // accounts with a linked phone credential, which is every real account.
    // Binding writes to this claim is what stops a signed in user from
    // claiming a phone number that is not theirs.
    function verifiedPhone() {
      return request.auth.token.phone_number;
    }

    // ---------------------------------------------------------------- users

    match /users/{userId} {
      // Profiles are readable by any signed in user so that a chat can show a
      // name and picture. Nothing sensitive lives here.
      allow read: if signedIn();
      // A profile is a handful of known fields. Refusing anything else
      // stops the document being used as free storage, and stops a client
      // writing a field the app would later read as if the server set it.
      function validProfile() {
        return incoming().name is string
            && incoming().name.size() > 0
            && incoming().name.size() <= 80
            && incoming().keys().hasOnly([
                 'phone', 'name', 'photoUrl', 'fcmToken',
                 'activeSessionId', 'createdAt', 'updatedAt'
               ]);
      }

      allow create: if signedIn() && userId == uid()
                    && validProfile()
                    && incoming().phone == verifiedPhone();
      allow update: if signedIn() && userId == uid()
                    && validProfile()
                    // The phone number is fixed at registration.
                    && incoming().phone == existing().phone;
      allow delete: if false;
    }

    // ------------------------------------------------------------- sessions

    // Which device currently holds the account, kept apart from the profile.
    //
    // It used to live on the user document, which coupled signing in to the
    // profile's own validation rules: a session-only write carries no name, so
    // for an account whose profile was missing the write was a create, failed
    // validProfile(), and both sign in and password reset died on a permission
    // error. The one-active-device rule has nothing to do with profile fields,
    // so it gets its own document.
    //
    // Private to its owner: nobody else needs to know which device holds an
    // account, and a session id is a value other devices compare against.
    match /sessions/{userId} {
      allow read: if signedIn() && userId == uid();
      allow write: if signedIn() && userId == uid()
                   && incoming().activeSessionId is string
                   && incoming().keys().hasOnly(['activeSessionId', 'updatedAt']);
    }

    // Claims a phone number for exactly one account. Create-only, so a number
    // can never be taken over by a later registration.
    //
    // The document id must equal the caller's own OTP-verified number.
    // Without that check any signed in user could squat on someone else's
    // number before they register, and could point lookups for that number at
    // their own account.
    match /phoneIndex/{e164} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && incoming().uid == uid()
                    && e164 == verifiedPhone();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------- threads

    match /threads/{threadId} {

      function isMember() {
        return signedIn() && uid() in resource.data.members;
      }

      function isMemberOfIncoming() {
        return signedIn() && uid() in incoming().members;
      }

      // A member may block the other one, and unblock them again, but may
      // not add or remove anybody else from that list: comparing both lists
      // with the caller's own uid taken out leaves exactly the part they are
      // not allowed to touch.
      function onlyOwnBlockChanged() {
        return incoming().get('blockedBy', []).removeAll([uid()])
            == existing().get('blockedBy', []).removeAll([uid()]);
      }

      // The same idea for the typing map, which is keyed by uid: a member may
      // announce that they are typing, and nobody else's entry may move with
      // it.
      function onlyOwnTypingChanged() {
        return incoming().get('typing', {}).diff(existing().get('typing', {}))
               .affectedKeys().hasOnly([uid()]);
      }

      // A thread is a known set of fields. Without this a member could use the
      // document as free storage, and — worse — could write the fields the
      // server owns, forging a handover or a departure the app would then
      // render as if a trigger had produced it.
      function validThreadShape() {
        return incoming().keys().hasOnly([
                 'members', 'isLocal', 'localContact', 'blockedBy', 'typing',
                 'lastMessage', 'updatedAt', 'departed', 'promotedAt'
               ]);
      }

      // Written by the handover trigger and by account deletion, both of
      // which hold admin credentials and so are not subject to these rules.
      function serverFieldsUnchanged() {
        return incoming().get('departed', []) == existing().get('departed', [])
            && incoming().get('promotedAt', 0) == existing().get('promotedAt', 0);
      }

      // A one-sided thread has exactly one member, the person who created it;
      // a real conversation has exactly two, one of them the caller. Leaving
      // this open let a caller mark a two-party thread `isLocal` and so take
      // the local branch of validInitialStatus below, which is what allows a
      // SENT claim to skip the counterparty's acceptance.
      function validNewThread() {
        return incoming().isLocal is bool
            && incoming().members is list
            && (incoming().isLocal
                  ? incoming().members == [uid()]
                  : (incoming().members.size() == 2
                     && uid() in incoming().members
                     && incoming().members[0] != incoming().members[1]))
            && !incoming().keys().hasAny(['departed', 'promotedAt']);
      }

      allow read: if isMember();
      allow create: if isMemberOfIncoming()
                    && validThreadShape()
                    && validNewThread();
      allow update: if isMember()
                    && validThreadShape()
                    // Membership is set at creation and by the handover
                    // function only, never by an ordinary client update.
                    && incoming().members == existing().members
                    && incoming().isLocal == existing().isLocal
                    && serverFieldsUnchanged()
                    && onlyOwnBlockChanged()
                    && onlyOwnTypingChanged();
      allow delete: if false;

      // ----------------------------------------------------------- messages

      match /messages/{messageId} {

        function inThread() {
          return signedIn()
                 && uid() in get(/databases/$(database)/documents/threads/$(threadId)).data.members;
        }

        // Either side blocking the other closes the conversation to new
        // messages. History stays readable to both.
        function notBlocked() {
          return get(/databases/$(database)/documents/threads/$(threadId))
                 .data.get('blockedBy', []).size() == 0;
        }

        // Size and shape. A message is small: anything much larger than a
        // long paragraph is either a bug or an attempt to fill the database
        // at the project's expense.
        function validMessage() {
          // A photo, a voice note and a transaction card all carry a null
          // text, so the length check has to pass a null through rather than
          // call size() on it. See validNote below.
          return incoming().type in ['TEXT', 'IMAGE', 'VOICE', 'TXN', 'SYSTEM']
              && (incoming().get('text', null) == null
                  || incoming().text.size() <= 4000)
              && incoming().createdAt is int
              && incoming().keys().hasOnly([
                   'senderId', 'type', 'text', 'mediaUrl', 'mediaPublicId',
                   'durationMs', 'txnId', 'createdAt', 'deliveredTo', 'readBy'
                 ]);
        }

        allow read: if inThread();
        allow create: if inThread()
                      && notBlocked()
                      && incoming().senderId == uid()
                      && validMessage();
        // Only receipt fields may change after a message is written.
        allow update: if inThread()
                      && incoming().diff(existing()).affectedKeys()
                         .hasOnly(['deliveredTo', 'readBy']);
        allow delete: if false;
      }

      // ------------------------------------------------------- transactions

      match /transactions/{txnId} {

        function members() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data.members;
        }

        function inThread() {
          return signedIn() && uid() in members();
        }

        // A blocked conversation records no new money either. What is already
        // recorded stays exactly as it is: blocking someone must not erase
        // what is owed.
        function notBlocked() {
          return get(/databases/$(database)/documents/threads/$(threadId))
                 .data.get('blockedBy', []).size() == 0;
        }

        function isLocalThread() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data.isLocal == true;
        }

        // An amount is poisha, so the ceiling is ten million taka on one
        // entry. Anything larger is a slipped decimal point or an attempt to
        // make a balance unreadable, and a real debt that size is not being
        // settled through a chat app.
        function validAmount() {
          return incoming().amountMinor is int
              && incoming().amountMinor > 0
              && incoming().amountMinor <= 1000000000;
        }

        // An optional field is written as an explicit null rather than left
        // out: the client uploads the whole entry on every retry, and a field
        // that has been cleared — `reversedBy` when a correction is refused —
        // has to be cleared on the server too, which omitting it would not do.
        //
        // `get(field, default)` only supplies the default when the key is
        // absent, so a present null came back as null, and `null.size()` and
        // `null is int` are an error and a false. Both denied every entry with
        // no note or no due date, which is most of them.
        function validNote() {
          return (incoming().get('note', null) == null
                  || incoming().note.size() <= 500)
              && (incoming().get('dueDate', null) == null
                  || incoming().dueDate is int);
        }

        function validDirection() {
          return incoming().direction in ['SENT', 'RECEIVED'];
        }

        // A SENT claim raises the counterparty's debt, so it starts PENDING.
        // A RECEIVED claim only lowers it, so it applies at once.
        // On a local (one-sided) thread there is nobody to accept, so both
        // start ACCEPTED and carry unconfirmed = true.
        //
        // `unconfirmed` means "inherited history nobody has reviewed", and it
        // keeps an entry out of the other person's balance. On a real thread
        // there is no history to inherit, so it must start false: otherwise an
        // author could acknowledge a repayment and keep the credit from
        // counting for the person who made it.
        function validInitialStatus() {
          return isLocalThread()
            ? (incoming().status == 'ACCEPTED' && incoming().unconfirmed == true)
            : (incoming().unconfirmed == false
               && (incoming().direction == 'SENT'
                     ? incoming().status == 'PENDING'
                     : incoming().status == 'ACCEPTED'));
        }

        // A transaction is a known set of fields, for the same reason a
        // message is: an unknown one is either a bug or an attempt to use the
        // ledger as storage.
        function validShape() {
          return incoming().keys().hasOnly([
                   'createdBy', 'direction', 'amountMinor', 'note',
                   'photoUrl', 'photoPublicId', 'dueDate', 'status',
                   'unconfirmed', 'reversesId', 'reversedBy', 'createdAt',
                   'resolvedAt', 'resolvedBy'
                 ])
              && incoming().createdAt is int;
        }

        // Optional fields are read with a default. Comparing a field that
        // is absent from one side throws, which would deny the write for a
        // reason that has nothing to do with what it was trying to do.
        function immutableFieldsUnchanged() {
          return incoming().createdBy == existing().createdBy
              && incoming().direction == existing().direction
              && incoming().amountMinor == existing().amountMinor
              && incoming().createdAt == existing().createdAt
              && incoming().get('reversesId', null) == existing().get('reversesId', null);
        }

        allow read: if inThread();

        // Settling an entry moves its status and records who moved it, and
        // touches nothing else. Without this the counterparty could rewrite
        // the note, the receipt photo or the due date in the same write that
        // accepted the amount.
        function onlySettlementChanged() {
          return incoming().diff(existing()).affectedKeys()
                 .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
        }

        allow create: if inThread()
                      && notBlocked()
                      && incoming().createdBy == uid()
                      && validShape()
                      && validAmount()
                      && validNote()
                      && validDirection()
                      && validInitialStatus();

        allow update: if inThread()
                      && validShape()
                      && immutableFieldsUnchanged()
                      && (
                        // Writing exactly what is already stored changes
                        // nothing and is always allowed. The client uploads
                        // the whole transaction on every retry, so without
                        // this a retry after a successful write that the
                        // client never heard about would be denied for ever.
                        incoming().diff(existing()).affectedKeys().size() == 0

                        // The counterparty accepts or rejects a pending item.
                        || (existing().status == 'PENDING'
                          && existing().createdBy != uid()
                          && incoming().status in ['ACCEPTED', 'REJECTED']
                          && incoming().resolvedBy == uid()
                          && onlySettlementChanged())

                        // The author cancels their own pending item.
                        || (existing().status == 'PENDING'
                          && existing().createdBy == uid()
                          && incoming().status == 'CANCELLED'
                          && incoming().resolvedBy == uid()
                          && onlySettlementChanged())

                        // The inheriting user reviews unconfirmed history.
                        // Only they may clear the flag, and only on a row they
                        // did not write themselves.
                        || (existing().get('unconfirmed', false) == true
                          && existing().createdBy != uid()
                          && incoming().unconfirmed == false
                          && incoming().status in ['ACCEPTED', 'REJECTED']
                          && incoming().resolvedBy == uid()
                          && incoming().diff(existing()).affectedKeys().hasOnly(
                               ['status', 'unconfirmed', 'resolvedAt', 'resolvedBy']))

                        // The pointer to a correcting entry. Either member may
                        // set it when they record a correction and clear it
                        // again if that correction is refused, because it is
                        // derived from the reversing row rather than being
                        // money in its own right. Nothing else moves with it,
                        // and the entry stays accepted throughout.
                        || (existing().status == 'ACCEPTED'
                          && incoming().status == 'ACCEPTED'
                          && incoming().diff(existing()).affectedKeys()
                             .hasOnly(['reversedBy']))
                      );

        // Accepted, rejected and cancelled entries are permanent. Corrections
        // are made with a reversing entry, never by editing history.
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------- reports

    // Written only by the fileReport function, which checks that the
    // reporter is in the thread and applies a rate limit — neither of which
    // a rule can do. Clients cannot read reports either, so nobody can
    // enumerate who has been reported.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------- limits

    // The counters behind the server-side rate limits. A client that could
    // write these could lift its own limit, and one that could read them
    // would learn how close it was to the ceiling, so neither is allowed.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // ------------------------------------------------- per-user subcollections

    match /users/{userId}/threadBalances/{threadId} {
      allow read, write: if signedIn() && userId == uid();
    }

    match /users/{userId}/localContacts/{contactId} {
      allow read, write: if signedIn() && userId == uid();
    }
  }
}
